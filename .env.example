NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/medical_aesthetics
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d
FIELD_ENCRYPT_KEY=dev-key-32-bytes-base64-encoded==
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# 以下是真实部署才需要的，本地留空
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
TONGYI_API_KEY=
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-beijing
# OSS_ENDPOINT=         # 可选：填了就用它，不填就从 OSS_REGION 拼
# ⚠️ OSS 控制台 bucket 跨域（CORS）必须配置，否则前端 PUT 会被浏览器拦：
#   来源 = http://localhost:5173（dev）+ 你的生产域名
#   Methods = PUT, GET, POST, DELETE, HEAD
#   Headers = *
#   Expose = ETag, x-oss-request-id
WECHATPAY_MCH_ID=
WECHATPAY_API_V3_KEY=
WECHATPAY_NOTIFY_URL=
WECHATPAY_APPID=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
WECHAT_BOT_WEBHOOK=
